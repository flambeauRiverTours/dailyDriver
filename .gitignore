# .NET build outputs (backend/ + desktop/) — android/ has its own .gitignore for Gradle output
[Bb]in/
[Oo]bj/
*.user

# Visual Studio
.vs/

# Azure Functions local secrets — connection strings live here, never commit
local.settings.json

# OS cruft
.DS_Store
Thumbs.db

# Editor
.vscode/

# MkDocs build output — the site is published by CI, never committed
site/

# Signing keys — never commit these. A leaked release key lets someone else publish an APK that
# Android will accept as an update to yours, and it cannot be rotated without uninstalling.
*.jks
*.keystore
*.jks.base64

#tasks is used for temporary notes
tasks/

# log files contain potentially sensitive info
dailydriver-command-log-*.jsonl

# Model weights (T030). Hundreds of megabytes to gigabytes, and Gemma-licensed: the terms T094
# examined attach redistribution obligations to anyone who passes them on, and a git history is
# passing them on. Weights are downloaded at runtime by design (§4.5) and never bundled, so the
# only way one reaches a remote is somebody committing it. "The repo is private" is not a defence:
# a T014 command-log export was once committed here, and purging it meant rewriting history rather
# than deleting a file. Treat anything that reaches a commit as published.
# Note .task does NOT imply a zip bundle: the -web variants are raw TFLite flatbuffers, so match
# on extension rather than on content.
*.task
*.litertlm
*.bin
*.tar.gz
*.tgz
