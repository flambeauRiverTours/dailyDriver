<Window x:Class="Notes.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Notes.Desktop"
        xmlns:vm="clr-namespace:Notes.Desktop.ViewModels"
        xmlns:views="clr-namespace:Notes.Desktop.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:NoteListViewModel}">
            <views:NoteListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NoteEditorViewModel}">
            <views:NoteEditorView />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding ListColumnWidth, Mode=TwoWay}" MinWidth="100" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <ContentControl Grid.Column="0" Content="{Binding List}" />

        <GridSplitter Grid.Column="1"
                  Width="5"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch" />

        <ContentControl Grid.Column="2" Content="{Binding Editor}" />
    </Grid>
</Window>
